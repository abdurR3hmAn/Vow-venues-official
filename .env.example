# Database Configuration
DATABASE_URL=mongodb://localhost:27017/vowvenues

# Email Configuration for Booking Notifications
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Gmail App Password Instructions:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Go to Google Account settings -> Security -> App passwords
# 3. Generate an app password for "Mail"
# 4. Use that 16-character password as EMAIL_PASSWORD

# Alternative Email Services:
# For Outlook: use service: 'outlook'
# For Yahoo: use service: 'yahoo'
# For custom SMTP: configure host, port, and auth in emailService.ts

# Example Gmail setup:
# EMAIL_USER=vowvenues@gmail.com
# EMAIL_PASSWORD=abcd efgh ijkl mnop
